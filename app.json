{
  "expo": {
    "name": "truevision",
    "slug": "truevision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tv-icon.png",
    "scheme": "truevision",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.truevision.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/tv-icon.png",
        "backgroundImage": "./assets/images/tv-icon.png",
        "monochromeImage": "./assets/images/tv-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.truevision.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/tv-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tv-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video"
    ]
  }
}
